# CryptoShield Guardian AI - Backend Production Environment Variables
# This file contains environment variables for the PRODUCTION backend deployment

# Environment identifier
ENV=production

# Database Configuration (PostgreSQL for production)
DATABASE_URL=postgresql://user:password@host:5432/cryptoshield_production

# JWT Secret (production-specific secret - MUST be different from staging)
JWT_SECRET=REPLACE_WITH_PRODUCTION_JWT_SECRET_MIN_32_CHARS

# Stripe API Keys (live mode for production)
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_PRODUCTION_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_PRODUCTION_WEBHOOK_SECRET

# Email/SendGrid Configuration (production)
EMAIL_API_KEY=REPLACE_WITH_PRODUCTION_EMAIL_API_KEY
EMAIL_FROM=noreply@cryptoshield.app

# CORS Allowed Origins (production frontend)
CORS_ALLOWED_ORIGINS=["https://cryptoshield.app","https://www.cryptoshield.app"]

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Logging
LOG_LEVEL=WARNING

# Feature Flags
ENABLE_VOICE_ANALYSIS=true
ENABLE_WALLET_TRACING=true
ENABLE_GPS_TRACKING=true
ENABLE_SUBSCRIPTION_SYSTEM=true
