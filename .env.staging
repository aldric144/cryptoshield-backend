# CryptoShield Guardian AI - Backend Staging Environment Variables
# This file contains environment variables for the STAGING backend deployment

# Environment identifier
ENV=staging

# Database Configuration (PostgreSQL for staging)
DATABASE_URL=postgresql://user:password@host:5432/cryptoshield_staging

# JWT Secret (staging-specific secret)
JWT_SECRET=REPLACE_WITH_STAGING_JWT_SECRET_MIN_32_CHARS

# Stripe API Keys (test mode for staging)
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STAGING_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STAGING_WEBHOOK_SECRET

# Email/SendGrid Configuration (staging)
EMAIL_API_KEY=REPLACE_WITH_STAGING_EMAIL_API_KEY
EMAIL_FROM=noreply-staging@cryptoshield.app

# CORS Allowed Origins (staging frontend)
CORS_ALLOWED_ORIGINS=["https://staging.cryptoshield.app","https://cryptoshield-frontend-staging.vercel.app","http://localhost:5173","http://localhost:3000"]

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Logging
LOG_LEVEL=INFO

# Feature Flags
ENABLE_VOICE_ANALYSIS=true
ENABLE_WALLET_TRACING=true
ENABLE_GPS_TRACKING=true
ENABLE_SUBSCRIPTION_SYSTEM=true
