# CryptoShield Guardian AI - Backend Local Development Environment Variables
# Copy this file to .env and fill in your local values

# Environment identifier
ENV=development

# Database Configuration (in-memory for local development)
DATABASE_URL=sqlite:///./cryptoshield_dev.db

# JWT Secret (local development - use a simple secret)
JWT_SECRET=local_dev_secret_key_min_32_characters_long

# Stripe API Keys (test mode for local development)
STRIPE_SECRET_KEY=sk_test_YOUR_LOCAL_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_LOCAL_WEBHOOK_SECRET

# Email/SendGrid Configuration (local - can use test keys or disable)
EMAIL_API_KEY=YOUR_LOCAL_EMAIL_API_KEY
EMAIL_FROM=dev@localhost

# CORS Allowed Origins (local development)
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Logging
LOG_LEVEL=DEBUG

# Feature Flags
ENABLE_VOICE_ANALYSIS=true
ENABLE_WALLET_TRACING=true
ENABLE_GPS_TRACKING=true
ENABLE_SUBSCRIPTION_SYSTEM=true
